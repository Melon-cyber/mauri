<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:orientation="vertical"
    android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="12dp" android:paddingBottom="8dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:id="@+id/widget_art" android:layout_width="56dp" android:layout_height="56dp"
            android:background="@drawable/widget_art_bg" android:clipToOutline="true" android:contentDescription="@null"
            android:scaleType="centerCrop" android:src="@drawable/mauri_foreground" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="12dp" android:layout_marginEnd="4dp" android:orientation="vertical">
            <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:ellipsize="end" android:maxLines="1" android:text="@string/widget_app" android:textColor="#FFF7F3EF" android:textSize="16sp" android:textStyle="bold" />
            <TextView android:id="@+id/widget_artist" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:ellipsize="end" android:maxLines="1" android:text="@string/widget_hint" android:textColor="#B3F7F3EF" android:textSize="13sp" />
        </LinearLayout>
        <ImageButton android:id="@+id/widget_like" android:layout_width="44dp" android:layout_height="44dp"
            android:background="@android:color/transparent" android:contentDescription="@string/widget_like" android:src="@drawable/ic_w_heart" />
    </LinearLayout>
    <ProgressBar android:id="@+id/widget_progress" style="@android:style/Widget.Material.ProgressBar.Horizontal"
        android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="10dp"
        android:max="1000" android:progress="0" android:progressTint="#FFF04444" android:progressBackgroundTint="#55F7F3EF" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:orientation="horizontal">
        <TextView android:id="@+id/widget_time" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="@string/widget_zero" android:textColor="#99F7F3EF" android:textSize="11sp" />
        <TextView android:id="@+id/widget_duration" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/widget_zero" android:textColor="#99F7F3EF" android:textSize="11sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="horizontal">
        <ImageButton android:id="@+id/widget_back10" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
            android:background="@android:color/transparent" android:contentDescription="@string/widget_back10" android:src="@drawable/ic_w_back10" />
        <ImageButton android:id="@+id/widget_prev" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
            android:background="@android:color/transparent" android:contentDescription="@string/widget_prev" android:src="@drawable/ic_w_prev" />
        <ImageButton android:id="@+id/widget_play" android:layout_width="50dp" android:layout_height="50dp" android:layout_marginStart="6dp" android:layout_marginEnd="6dp"
            android:background="@drawable/widget_play_bg" android:contentDescription="@string/widget_play" android:src="@drawable/ic_w_play" />
        <ImageButton android:id="@+id/widget_next" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
            android:background="@android:color/transparent" android:contentDescription="@string/widget_next" android:src="@drawable/ic_w_next" />
        <ImageButton android:id="@+id/widget_fwd10" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
            android:background="@android:color/transparent" android:contentDescription="@string/widget_fwd10" android:src="@drawable/ic_w_fwd10" />
    </LinearLayout>
</LinearLayout>
